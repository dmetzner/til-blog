---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import { config } from "../config";
import Bi from "../components/Bi.astro";
import PostCard from "../components/PostCard.astro";
import Base from "../layouts/Base.astro";
import { byDateDesc, readingMinutes, tagCounts } from "../lib/posts";

// Paginated home. Rest param → page 1 lives at "/", the rest at "/2", "/3"…
// With few posts there's just one page; pagination kicks in past pageSize.
export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(byDateDesc);
  // Site-wide numbers, computed at build from the posts themselves — no
  // analytics call, nothing to keep in sync, and they cannot go stale.
  const stats = {
    notes: posts.length,
    minutes: posts.reduce((sum, p) => sum + readingMinutes(p.body ?? ""), 0),
    tags: tagCounts(posts).length,
    since: posts[posts.length - 1]?.data.pubDate,
  };
  return paginate(posts, { pageSize: 12, props: { stats } });
}) satisfies GetStaticPaths;

const { page, stats } = Astro.props;
const monthYear = (d: Date, locale: string) =>
  d.toLocaleDateString(locale, { month: "long", year: "numeric" });
const first = page.currentPage === 1;
const title = first ? "til · daniel metzner" : `Page ${page.currentPage} · til`;
---

<Base title={title} prev={page.url.prev} next={page.url.next}>
  <h1 class="lead">Today I Learned</h1>

  {
    first && (
      <p class="lead-sub">
        <Bi en={config.tagline.en} de={config.tagline.de} />
      </p>
    )
  }

  {
    first && (
      <p class="stats mono">
        <span>
          <Bi en={`${stats.notes} notes`} de={`${stats.notes} Notizen`} />
        </span>
        <span>
          <Bi en={`~${stats.minutes} min to read all`} de={`~${stats.minutes} Min. Lesezeit`} />
        </span>
        <a href="/tags/">{stats.tags} tags</a>
        {stats.since && (
          <span>
            <Bi
              en={`since ${monthYear(stats.since, "en-GB")}`}
              de={`seit ${monthYear(stats.since, "de-AT")}`}
            />
          </span>
        )}
      </p>
    )
  }

  <ul class="post-list">
    {page.data.map((post) => <PostCard post={post} />)}
  </ul>

  {
    page.lastPage > 1 && (
      <nav class="pagination mono" aria-label="Pages">
        {page.url.prev ? (
          <a href={page.url.prev}>
            <Bi en="← newer" de="← neuer" />
          </a>
        ) : (
          <span class="disabled">
            <Bi en="← newer" de="← neuer" />
          </span>
        )}
        <span class="page-count">
          {page.currentPage} / {page.lastPage}
        </span>
        {page.url.next ? (
          <a href={page.url.next}>
            <Bi en="older →" de="älter →" />
          </a>
        ) : (
          <span class="disabled">
            <Bi en="older →" de="älter →" />
          </span>
        )}
      </nav>
    )
  }
</Base>
