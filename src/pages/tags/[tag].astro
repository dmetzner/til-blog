---
import { getCollection } from "astro:content";
import Bi from "../../components/Bi.astro";
import BackLink from "../../components/BackLink.astro";
import PostCard from "../../components/PostCard.astro";
import Base from "../../layouts/Base.astro";
import { postsForTagSlug, tagCounts, tagSlug } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  // One route per distinct tag; carry the original label for display.
  return tagCounts(posts).map(({ tag }) => ({
    params: { tag: tagSlug(tag) },
    props: { label: tag, posts: postsForTagSlug(posts, tagSlug(tag)) },
  }));
}

const { label, posts } = Astro.props;
---

<Base title={`#${label} · til`} description={`TIL notes tagged ${label}.`}>
  <h1 class="lead">
    <Bi en="Tagged" de="Getaggt mit" />
    <span class="accent">#{label}</span>
  </h1>
  <p class="lead-sub">
    <Bi
      en={`${posts.length} note${posts.length === 1 ? "" : "s"}.`}
      de={`${posts.length} Notiz${posts.length === 1 ? "" : "en"}.`}
    />
  </p>

  <ul class="post-list">
    {posts.map((post) => <PostCard post={post} />)}
  </ul>

  <BackLink to="tags" />
</Base>
