---
import { getCollection } from "astro:content";
import BackLink from "../../components/BackLink.astro";
import PostCard from "../../components/PostCard.astro";
import Base from "../../layouts/Base.astro";
import { postsForTagSlug, tagCounts, tagSlug } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  // One route per distinct tag; carry the original label for display.
  return tagCounts(posts).map(({ tag }) => ({
    params: { tag: tagSlug(tag) },
    props: { label: tag, posts: postsForTagSlug(posts, tagSlug(tag)) },
  }));
}

const { label, posts } = Astro.props;
---

<Base title={`#${label} · til`} description={`TIL notes tagged ${label}.`}>
  <h1 class="lead">
    <span data-lang-en>Tagged</span>
    <span data-lang-de lang="de">Getaggt mit</span>
    <span class="accent">#{label}</span>
  </h1>
  <p class="lead-sub">
    <span data-lang-en>
      {posts.length} note{posts.length === 1 ? "" : "s"}.
    </span>
    <span data-lang-de lang="de">
      {posts.length} Notiz{posts.length === 1 ? "" : "en"}.
    </span>
  </p>

  <ul class="post-list">
    {posts.map((post) => <PostCard post={post} />)}
  </ul>

  <BackLink to="tags" />
</Base>
