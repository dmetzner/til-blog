---
// "back to the index" — five pages carried their own copy of this, in English
// only. One place, both languages.
import Bi from "./Bi.astro";

interface Props {
  /** where back leads: the note index (default) or the tag index */
  to?: "notes" | "tags";
}
const { to = "notes" } = Astro.props;
const tags = to === "tags";
---

<a class="back" href={tags ? "/tags/" : "/"}>
  <Bi en={tags ? "← all tags" : "← all notes"} de={tags ? "← alle Tags" : "← alle Notizen"} />
</a>
